# FoodBridge Backend Environment Configuration

# Server
PORT=5000
NODE_ENV=development

# MySQL Database connection string for Prisma
# Format: mysql://USER:PASSWORD@HOST:PORT/DATABASE
DATABASE_URL="mysql://root:@localhost:3306/food_donation"

# JWT Authentication Secret and Expiry
JWT_SECRET="foodbridge_super_secure_jwt_secret_key_2026"
JWT_EXPIRES_IN="7d"

# Frontend Origin for CORS
FRONTEND_URL="http://localhost:5173"
