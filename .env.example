# FoodBridge Root Environment Configuration Template
# Copy this file to backend/.env and frontend/.env as needed, or use as reference.

# ================================
# Database Configuration
# ================================
# Format: mysql://USER:PASSWORD@HOST:PORT/DATABASE
# Default for local XAMPP / MariaDB: mysql://root:@localhost:3306/food_donation
# Default for Docker Compose: mysql://root:@localhost:3306/food_donation
DATABASE_URL="mysql://root:@localhost:3306/food_donation"

# ================================
# Backend Server Configuration
# ================================
PORT=5000
NODE_ENV=development
JWT_SECRET="foodbridge_super_secure_jwt_secret_key_2026"
JWT_EXPIRES_IN="7d"
FRONTEND_URL="http://localhost:5173"

# ================================
# Frontend Configuration
# ================================
# Set to "/api" for Vite local proxy or full URL for deployed production
VITE_API_URL="/api"
